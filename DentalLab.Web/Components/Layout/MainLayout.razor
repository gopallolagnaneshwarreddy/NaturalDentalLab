@inherits LayoutComponentBase

<div class="page">
    <!-- Sidebar Navigation -->
    <nav id="app-sidebar" class="sidebar" role="navigation" aria-label="Main navigation">
        <NavMenu />
    </nav>

    <!-- Dim overlay behind the mobile drawer (tap to close) -->
    <div class="nav-backdrop" data-nav-close aria-hidden="true"></div>

    <!-- Main Content Area -->
    <main role="main">
        <!-- Top Navigation Bar -->
        <div class="top-row px-4" role="banner">
            <div class="top-row-left">
                <button type="button" class="menu-toggle" data-nav-toggle
                        aria-label="Open navigation menu" aria-controls="app-sidebar" aria-expanded="false">
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6.5h16M4 12h16M4 17.5h16"/></svg>
                </button>
                <span class="top-row-tagline">Case management &amp; billing</span>
            </div>
            <span class="top-row-date">@DateTime.Now.ToString("dddd, dd MMMM yyyy")</span>
        </div>

        <!-- Page Content -->
        <article class="content px-4" role="article">
            @Body
        </article>
    </main>
</div>

<!-- Error Boundary UI -->
<div id="blazor-error-ui" data-nosnippet role="alert" aria-live="assertive">
    An unhandled error has occurred.
    <a href="." class="reload">Reload the page</a>
    <span class="dismiss" role="button" tabindex="0" title="Close" aria-label="Close error message">✕</span>
</div>
