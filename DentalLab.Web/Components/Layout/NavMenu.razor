@implements IDisposable
@inject NavigationManager NavigationManager
@inject PermissionStore Permissions

<div class="brand-row">
    <a class="brand-link" href="/dashboard">
        <span class="brand-mark" aria-hidden="true">
            <svg viewBox="0 0 40 40" width="26" height="26" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M20 4c-3.2 0-5 1.7-7.4 1.7-2.6 0-4.9-1.4-7-1.1-2.8.4-4.4 3-4.2 6.4.3 5.2 1.7 9.9 3.4 14.3 1.2 3.1 2.1 6.9 4.6 6.9 2.3 0 2.3-4.9 3.6-9.6.7-2.5 1.4-4.3 2.9-4.3s2.3 1.9 2.9 4.3c1.3 4.7 1.3 9.6 3.6 9.6 2.5 0 3.4-3.8 4.6-6.9 1.7-4.4 3.1-9.1 3.4-14.3.2-3.4-1.4-6-4.2-6.4-2.1-.3-4.4 1.1-7 1.1-.7 0-1.4-.2-2.2-.4V4Z" fill="url(#navToothGrad)"/>
                <path d="M22 4.6c1.8-1.6 4-2.2 5.8-1 1.5 1 1.9 2.7 1 4.4-.9 1.7-3.1 3-5.6 2.8" stroke="#b8873a" stroke-width="1.4" stroke-linecap="round"/>
                <defs>
                    <linearGradient id="navToothGrad" x1="4" y1="4" x2="34" y2="36" gradientUnits="userSpaceOnUse">
                        <stop stop-color="#5eead4"/>
                        <stop offset="1" stop-color="#0f766e"/>
                    </linearGradient>
                </defs>
            </svg>
        </span>
        <span class="brand-copy">
            <strong>Natural Dental Labs</strong>
            <small>Case &amp; billing console</small>
        </span>
    </a>
    <button type="button" class="nav-close" data-nav-close aria-label="Close navigation menu">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
    </button>
</div>

<div class="nav-scrollable">
    <nav class="nav flex-column">
        @if (Can(Perm.DashboardView))
        {
            <div class="nav-group-label">Overview</div>
            @if (Can(Perm.DashboardView))
            {
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="dashboard" Match="NavLinkMatch.All">
                            <span class="nav-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V20a1 1 0 0 0 1 1h4v-6h4v6h4a1 1 0 0 0 1-1V9.5"/></svg>
                            </span>
                            Dashboard
                        </NavLink>
                    </div>
            }
        }

        @if (Can(Perm.DoctorsManage) || Can(Perm.CaseTypesManage) || Can(Perm.RatesManage))
        {
            <div class="nav-group-label">Practice</div>
            @if (Can(Perm.DoctorsManage))
            {
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="doctors">
                            <span class="nav-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3.2"/><path d="M3.5 20c.7-3.4 3-5.4 5.5-5.4s4.8 2 5.5 5.4"/><circle cx="17.5" cy="9" r="2.4"/><path d="M15.7 14.8c2.2.3 3.9 2 4.4 4.5"/></svg>
                            </span>
                            Doctors
                        </NavLink>
                    </div>
            }
            @if (Can(Perm.CaseTypesManage))
            {
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="case-types">
                            <span class="nav-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5h16"/><path d="M4 12h10"/><path d="M4 19h13"/></svg>
                            </span>
                            Case Types
                        </NavLink>
                    </div>
            }
            @if (Can(Perm.RatesManage))
            {
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="doctor-rates">
                            <span class="nav-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.5"/><path d="M12 7.5v9M14.7 9.7c0-1.2-1.2-2.1-2.7-2.1s-2.7.9-2.7 2c0 3 5.4 1.5 5.4 4.4 0 1.2-1.2 2.1-2.7 2.1s-2.7-.9-2.7-2.1"/></svg>
                            </span>
                            Doctor Rates
                        </NavLink>
                    </div>
            }
        }

        @if (Can(Perm.CasesView) || Can(Perm.ApprovalsView))
        {
            <div class="nav-group-label">Operations</div>
            @if (Can(Perm.CasesView))
            {
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="cases">
                            <span class="nav-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3.5" width="16" height="17" rx="2"/><path d="M8 8h8M8 12h8M8 16h5"/></svg>
                            </span>
                            Cases
                        </NavLink>
                    </div>
            }
            @if (Can(Perm.ApprovalsView))
            {
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="approval-requests">
                            <span class="nav-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 4h6a1 1 0 0 1 1 1v1H8V5a1 1 0 0 1 1-1Z"/><rect x="5.5" y="6" width="13" height="14.5" rx="2"/><path d="m9 13 2 2 4-4"/></svg>
                            </span>
                            Approval Requests
                        </NavLink>
                    </div>
            }
        }

        @if (Can(Perm.CasesBulkEntry))
        {
            <div class="nav-group-label">Bulk Case Entry</div>
            @if (Can(Perm.CasesBulkEntry))
            {
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="cases/bulk/by-date">
                            <span class="nav-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3.5" y="5" width="17" height="15.5" rx="2"/><path d="M3.5 9.5h17M8 3v4M16 3v4"/><path d="M8 13.5h3M8 16.5h6"/></svg>
                            </span>
                            Cases by Date
                        </NavLink>
                    </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="cases/bulk/by-doctor">
                            <span class="nav-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3.2"/><path d="M3.5 20c.7-3.4 3-5.4 5.5-5.4s4.8 2 5.5 5.4"/><path d="M16 10h5M16 13.5h5M16 17h3"/></svg>
                            </span>
                            Cases by Doctor
                        </NavLink>
                    </div>
            }
        }

        @if (Can(Perm.BillingView) || Can(Perm.ReportsMonthly) || Can(Perm.PaymentsView))
        {
            <div class="nav-group-label">Billing &amp; Reports</div>
            @if (Can(Perm.BillingView))
            {
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="doctor-bill">
                            <span class="nav-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3.5" width="16" height="17" rx="2"/><path d="M8 8h8M8 12h5M8 16h8"/><circle cx="17" cy="16.5" r="3.2"/><path d="M17 15.2v1.6l1 .7"/></svg>
                            </span>
                            Doctor Bill
                        </NavLink>
                    </div>
            }
            @if (Can(Perm.PaymentsView))
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="doctor-payments">
                        <span class="nav-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="6" width="18" height="13" rx="2"/><path d="M3 10h18"/><path d="M7 15h3"/><path d="M15.5 15.5l1.5 1.5 3-3.5"/></svg>
                        </span>
                        Doctor Payments
                    </NavLink>
                </div>
            }
            @if (Can(Perm.ReportsMonthly))
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="reports/monthly">
                        <span class="nav-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3.5" y="4.5" width="17" height="16" rx="2"/><path d="M3.5 9h17M8 3v3M16 3v3"/><path d="M8 17v-3M12 17v-5M16 17v-2"/></svg>
                        </span>
                        Monthly Summary
                    </NavLink>
                </div>
            }
        }

        @if (Can(Perm.UsersManage) || IsOwner)
        {
            <div class="nav-group-label">Administration</div>
            @if (Can(Perm.UsersManage))
            {
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="users">
                            <span class="nav-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="9.5" cy="8" r="3.2"/><path d="M3.5 20c.7-3.4 3-5.4 6-5.4s5.3 2 6 5.4"/><path d="M17 8.2h4M19 6.2v4"/></svg>
                            </span>
                            Users
                        </NavLink>
                    </div>
            }
            @if (IsOwner)
            {
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="access-control">
                            <span class="nav-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 5 6v5c0 4.4 3 8.3 7 9.5 4-1.2 7-5.1 7-9.5V6l-7-3Z"/><path d="m9 12 2 2 4-4"/></svg>
                            </span>
                            Access Control
                        </NavLink>
                    </div>
            }
        }

        <AuthorizeView>
            <Authorized>
                <div class="nav-group-label">Account</div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Manage">
                        <span class="nav-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="3.4"/><path d="M5 20c.9-4 3.5-6.2 7-6.2s6.1 2.2 7 6.2"/></svg>
                        </span>
                        @context.User.Identity?.Name
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <form action="Account/Logout" method="post">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                        <button type="submit" class="nav-link nav-logout">
                            <span class="nav-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M15 4H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8"/><path d="M10 12h10m0 0-3.5-3.5M20 12l-3.5 3.5"/></svg>
                            </span>
                            Logout
                        </button>
                    </form>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Login">
                        <span class="nav-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 4h6a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H9"/><path d="M14 12H3m0 0 3.5-3.5M3 12l3.5 3.5"/></svg>
                        </span>
                        Login
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private string? currentUrl;
    private System.Security.Claims.ClaimsPrincipal? user;

    // Menu items follow Access Control; the Owner always sees everything.
    private bool Can(string policy) => Permissions.IsAllowed(user, policy);

    private bool IsOwner => user?.IsInRole(PermissionCatalog.OwnerRole) == true;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
        Permissions.Changed += OnPermissionsChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        await Permissions.EnsureFreshAsync();
        user = AuthenticationStateTask is null ? null : (await AuthenticationStateTask).User;
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        await Permissions.EnsureFreshAsync();
        await InvokeAsync(StateHasChanged);
    }

    // Owner saved new permissions: refresh this menu straight away.
    private void OnPermissionsChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
        Permissions.Changed -= OnPermissionsChanged;
    }
}
