@*
    Reusable case-line entry: case type picker + tooth grid (scope 'T') or
    arch picker (scope 'A') + the list of lines already added to this case.
    Used by the owner bulk-entry pages. Lines are added directly to the
    Lines list passed in; OnLinesChanged fires after every add/remove.
*@
@using DentalLab.Application.Models
@using DentalLab.Application.Models.Cases

<div class="row g-3">
    <div class="col-xl-8">
        <div class="border rounded p-3 h-100">
            <div class="fw-semibold mb-2">Add case line</div>

            @if (Rates.Count == 0)
            {
                <div class="alert alert-warning mb-0">
                    This doctor has no active case-type rates.
                    @if (CanAddRate)
                    {
                        <div class="mt-2">
                            <button type="button" class="btn btn-sm btn-primary" @onclick="OpenRateModal">
                                &#43; Add a case-type rate for this doctor
                            </button>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="row g-3 mb-3">
                    <div class="@(CanSeePrices ? "col-md-8" : "col-12")">
                        <div class="d-flex justify-content-between align-items-baseline">
                            <label class="form-label">Case type</label>
                            @if (CanAddRate)
                            {
                                <button type="button" class="btn btn-link btn-add-inline" @onclick="OpenRateModal"
                                        title="Case type not in the list? Add a rate for this doctor.">
                                    &#43; Case type not listed? Add rate
                                </button>
                            }
                        </div>
                        <select class="form-select" value="@selectedCaseTypeId" @onchange="CaseTypeChanged">
                            <option value="0">-- select case type --</option>
                            @foreach (var rate in Rates)
                            {
                                <option value="@rate.CaseTypeId">
                                    @rate.CaseTypeCode - @rate.CaseTypeName@(CanSeePrices ? $" ({rate.Cost:N2})" : "")
                                </option>
                            }
                        </select>
                    </div>

                    @if (CanSeePrices)
                    {
                        <div class="col-md-4">
                            <label class="form-label">Unit rate</label>
                            <div class="form-control bg-light">
                                @(selectedRate is null ? "-" : selectedRate.Cost.ToString("N2"))
                            </div>
                        </div>
                    }
                </div>

                @if (selectedRate is not null)
                {
                    @if (selectedRate.Scope == 'T')
                    {
                        <div class="odontogram">
                            <div class="text-muted small mb-3">Click a tooth number to select or clear it. Chart is shown from the dentist&#39;s view (patient&#39;s right on the left).</div>

                            <div class="tooth-matrix">
                                <div class="tooth-quadrant tooth-quadrant-right tooth-quadrant-upper">
                                    <div class="quadrant-title">Patient&#39;s Upper Right</div>
                                    <div class="tooth-row">
                                        @foreach (var tooth in RightTeeth)
                                        {
                                            var t = tooth;
                                            var selected = selectedTeeth[UpperRight].Contains(t);
                                            var used = IsToothAlreadyUsed(UpperRight, t);
                                            <button type="button" class="@GetToothButtonClass(selected, used)" disabled="@used"
                                                    @onclick="() => ToggleTooth(UpperRight, t)">@t</button>
                                        }
                                    </div>
                                </div>

                                <div class="tooth-quadrant tooth-quadrant-left tooth-quadrant-upper">
                                    <div class="quadrant-title">Patient&#39;s Upper Left</div>
                                    <div class="tooth-row">
                                        @foreach (var tooth in LeftTeeth)
                                        {
                                            var t = tooth;
                                            var selected = selectedTeeth[UpperLeft].Contains(t);
                                            var used = IsToothAlreadyUsed(UpperLeft, t);
                                            <button type="button" class="@GetToothButtonClass(selected, used)" disabled="@used"
                                                    @onclick="() => ToggleTooth(UpperLeft, t)">@t</button>
                                        }
                                    </div>
                                </div>

                                <div class="tooth-quadrant tooth-quadrant-right tooth-quadrant-lower">
                                    <div class="tooth-row">
                                        @foreach (var tooth in RightTeeth)
                                        {
                                            var t = tooth;
                                            var selected = selectedTeeth[LowerRight].Contains(t);
                                            var used = IsToothAlreadyUsed(LowerRight, t);
                                            <button type="button" class="@GetToothButtonClass(selected, used)" disabled="@used"
                                                    @onclick="() => ToggleTooth(LowerRight, t)">@t</button>
                                        }
                                    </div>
                                    <div class="quadrant-title quadrant-title-bottom">Patient&#39;s Lower Right</div>
                                </div>

                                <div class="tooth-quadrant tooth-quadrant-left tooth-quadrant-lower">
                                    <div class="tooth-row">
                                        @foreach (var tooth in LeftTeeth)
                                        {
                                            var t = tooth;
                                            var selected = selectedTeeth[LowerLeft].Contains(t);
                                            var used = IsToothAlreadyUsed(LowerLeft, t);
                                            <button type="button" class="@GetToothButtonClass(selected, used)" disabled="@used"
                                                    @onclick="() => ToggleTooth(LowerLeft, t)">@t</button>
                                        }
                                    </div>
                                    <div class="quadrant-title quadrant-title-bottom">Patient&#39;s Lower Left</div>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="mb-3">
                            <label class="form-label d-block">Arch</label>
                            <button type="button"
                                    class="btn me-2 @(selectedArch == 'U' ? "btn-primary" : "btn-outline-primary")"
                                    @onclick="() => SelectArch('U')">Upper Arch</button>
                            <button type="button"
                                    class="btn @(selectedArch == 'L' ? "btn-primary" : "btn-outline-primary")"
                                    @onclick="() => SelectArch('L')">Lower Arch</button>
                        </div>
                    }

                    <div class="d-flex justify-content-between align-items-center mt-3">
                        <div>
                            <strong>Current units:</strong> @CurrentUnits
                            @if (CanSeePrices)
                            {
                                <span class="ms-3"><strong>Amount:</strong> @CurrentAmount.ToString("N2")</span>
                            }
                        </div>
                        <button type="button" class="btn btn-primary" @onclick="AddLineAsync">Add line</button>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(lineError))
                {
                    <div class="alert alert-danger mt-3 mb-0">@lineError</div>
                }
            }
        </div>
    </div>

    <div class="col-xl-4">
        <div class="border rounded p-3 h-100">
            <div class="d-flex justify-content-between mb-2">
                <span class="fw-semibold">Lines in this case</span>
                <span class="badge bg-secondary">@Lines.Count</span>
            </div>

            @if (Lines.Count == 0)
            {
                <div class="text-muted small">No lines added yet.</div>
            }
            else
            {
                @foreach (var line in Lines)
                {
                    <div class="border rounded p-2 mb-2" @key="line.ClientLineId">
                        <div class="d-flex justify-content-between align-items-start">
                            <strong>@line.CaseTypeCode</strong>
                            <button type="button" class="btn btn-sm btn-outline-danger"
                                    @onclick="() => RemoveLineAsync(line.ClientLineId)">Remove</button>
                        </div>
                        <div class="small">@line.CaseTypeName</div>
                        <div class="small text-muted">@line.SelectionText</div>
                        <div class="d-flex justify-content-between mt-1 small">
                            <span>@line.Units unit(s)</span>
                            @if (CanSeePrices)
                            {
                                <strong>@line.Amount.ToString("N2")</strong>
                            }
                        </div>
                    </div>
                }

                <div class="border-top pt-2 small">
                    <div class="d-flex justify-content-between">
                        <span>Total units</span><strong>@Lines.Sum(x => x.Units)</strong>
                    </div>
                    @if (CanSeePrices)
                    {
                        <div class="d-flex justify-content-between">
                            <span>Total amount</span><strong>@Lines.Sum(x => x.Amount).ToString("N2")</strong>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

<QuickAddRateModal Visible="rateModalOpen"
                   DocId="DocId"
                   DocName="@DocName"
                   OnSaved="RateSavedAsync"
                   OnCancel="() => rateModalOpen = false" />

@code {
    private const string UpperRight = "UR";
    private const string UpperLeft = "UL";
    private const string LowerRight = "LR";
    private const string LowerLeft = "LL";

    private static readonly int[] RightTeeth = [8, 7, 6, 5, 4, 3, 2, 1];
    private static readonly int[] LeftTeeth = [1, 2, 3, 4, 5, 6, 7, 8];

    /// <summary>Active rates for the selected doctor.</summary>
    [Parameter, EditorRequired] public List<DoctorRateListItem> Rates { get; set; } = [];

    /// <summary>Lines of the case being built. The component adds to / removes from this list.</summary>
    [Parameter, EditorRequired] public List<CaseLineInput> Lines { get; set; } = [];

    [Parameter] public bool CanSeePrices { get; set; }

    [Parameter] public EventCallback OnLinesChanged { get; set; }

    /// <summary>Owner only: allow adding a missing case-type rate for this doctor.</summary>
    [Parameter] public bool CanAddRate { get; set; }

    [Parameter] public int DocId { get; set; }

    [Parameter] public string DocName { get; set; } = string.Empty;

    /// <summary>Raised after a rate is added; the page should reload Rates for the doctor.</summary>
    [Parameter] public EventCallback<int> OnRateAdded { get; set; }

    private bool rateModalOpen;
    private int? pendingCaseTypeId;

    private void OpenRateModal()
    {
        lineError = null;
        rateModalOpen = true;
    }

    private async Task RateSavedAsync(int caseTypeId)
    {
        rateModalOpen = false;
        pendingCaseTypeId = caseTypeId;
        await OnRateAdded.InvokeAsync(caseTypeId);
        ApplyPendingCaseType();
    }

    /// <summary>Once the reloaded rates arrive, select the case type that was just added.</summary>
    private void ApplyPendingCaseType()
    {
        if (pendingCaseTypeId is null)
        {
            return;
        }

        var rate = Rates.FirstOrDefault(r => r.CaseTypeId == pendingCaseTypeId.Value);
        if (rate is null)
        {
            return;
        }

        selectedCaseTypeId = rate.CaseTypeId;
        selectedRate = rate;
        lineError = null;
        ClearSelection();
        pendingCaseTypeId = null;
    }

    private readonly Dictionary<string, HashSet<int>> selectedTeeth = new()
    {
        [UpperRight] = [],
        [UpperLeft] = [],
        [LowerRight] = [],
        [LowerLeft] = []
    };

    private List<DoctorRateListItem>? lastRates;
    private DoctorRateListItem? selectedRate;
    private int selectedCaseTypeId;
    private char? selectedArch;
    private string? lineError;

    private int CurrentUnits => selectedRate?.Scope == 'A' ? 1 : selectedTeeth.Values.Sum(set => set.Count);
    private decimal CurrentAmount => selectedRate is null ? 0 : CurrentUnits * selectedRate.Cost;

    protected override void OnParametersSet()
    {
        // Doctor changed (new rates list) -> reset the in-progress selection.
        if (!ReferenceEquals(lastRates, Rates))
        {
            lastRates = Rates;
            selectedCaseTypeId = 0;
            selectedRate = null;
            lineError = null;
            ClearSelection();
        }

        ApplyPendingCaseType();
    }

    private void CaseTypeChanged(ChangeEventArgs args)
    {
        selectedCaseTypeId = int.TryParse(args.Value?.ToString(), out var id) ? id : 0;
        selectedRate = Rates.FirstOrDefault(rate => rate.CaseTypeId == selectedCaseTypeId);
        lineError = null;
        ClearSelection();
    }

    private static string GetToothButtonClass(bool selected, bool used)
    {
        var colorClass = selected ? "btn-primary" : used ? "btn-secondary" : "btn-outline-secondary";
        return $"btn tooth-button {colorClass}";
    }

    private void ToggleTooth(string quadrant, int tooth)
    {
        lineError = null;
        if (!selectedTeeth[quadrant].Add(tooth))
        {
            selectedTeeth[quadrant].Remove(tooth);
        }
    }

    private void SelectArch(char arch)
    {
        selectedArch = arch;
        lineError = null;
    }

    private bool IsToothAlreadyUsed(string quadrant, int tooth)
    {
        return Lines.Where(line => line.Scope == 'T').Any(line =>
        {
            var value = quadrant switch
            {
                UpperRight => line.UR,
                UpperLeft => line.UL,
                LowerRight => line.LR,
                LowerLeft => line.LL,
                _ => null
            };
            return value?.Contains((char)('0' + tooth)) == true;
        });
    }

    private async Task AddLineAsync()
    {
        lineError = null;

        if (selectedRate is null)
        {
            lineError = "Select a case type.";
            return;
        }

        if (selectedRate.Scope == 'T' && CurrentUnits == 0)
        {
            lineError = "Select at least one tooth.";
            return;
        }

        if (selectedRate.Scope == 'A' && selectedArch is not ('U' or 'L'))
        {
            lineError = "Select Upper Arch or Lower Arch.";
            return;
        }

        Lines.Add(new CaseLineInput
        {
            CaseTypeId = selectedRate.CaseTypeId,
            CaseTypeCode = selectedRate.CaseTypeCode,
            CaseTypeName = selectedRate.CaseTypeName,
            Scope = selectedRate.Scope,
            Arch = selectedRate.Scope == 'A' ? selectedArch : null,
            UR = BuildQuadrant(UpperRight, descending: true),
            UL = BuildQuadrant(UpperLeft, descending: false),
            LR = BuildQuadrant(LowerRight, descending: true),
            LL = BuildQuadrant(LowerLeft, descending: false),
            UnitRate = selectedRate.Cost
        });

        selectedCaseTypeId = 0;
        selectedRate = null;
        ClearSelection();

        await OnLinesChanged.InvokeAsync();
    }

    private string? BuildQuadrant(string quadrant, bool descending)
    {
        IEnumerable<int> values = selectedTeeth[quadrant];
        values = descending ? values.OrderByDescending(v => v) : values.OrderBy(v => v);
        var result = string.Concat(values);
        return result.Length == 0 ? null : result;
    }

    private async Task RemoveLineAsync(Guid clientLineId)
    {
        var line = Lines.FirstOrDefault(item => item.ClientLineId == clientLineId);
        if (line is not null)
        {
            Lines.Remove(line);
            await OnLinesChanged.InvokeAsync();
        }
    }

    private void ClearSelection()
    {
        foreach (var selection in selectedTeeth.Values)
        {
            selection.Clear();
        }
        selectedArch = null;
    }
}
