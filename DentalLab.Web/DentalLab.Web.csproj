<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>aspnet-DentalLab_Web-492f0358-dfdd-40d8-8102-10c9c95a8629</UserSecretsId>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11" PrivateAssets="all" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.11" />
    <!-- PDF downloads (Doctor Bill, Monthly Summary). Community licence: free for
         businesses under USD 1M annual revenue. -->
    <PackageReference Include="QuestPDF" Version="2026.5.0" />
    <!-- UPI "scan to pay" QR codes on bills (MIT licence) -->
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Fonts and images used inside generated PDFs, built into the app so they
         work the same on any server. -->
    <EmbeddedResource Include="Pdf\Fonts\*.ttf" />
    <EmbeddedResource Include="Pdf\Images\*.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DentalLab.Application\DentalLab.Application.csproj" />
    <ProjectReference Include="..\DentalLab.Infrastructure\DentalLab.Infrastructure.csproj" />
  </ItemGroup>

</Project>
